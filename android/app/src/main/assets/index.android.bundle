  "customize_dashboard_message": "તમારા માટે ડૅશબોર્ડને કસ્ટમાઇઝ કરવામાં આવી રહ્યું છે..",
  "login": "લૉગિન",
  "content": "સામગ્રી",
  "courses": "કોર્સ",
  "profile": "પ્રોફાઇલ",
  "usersname": "તમારું વપરાશકર્તા નામ કસ્ટમાઇઝ કરો",
  "username": "વપરાશકર્તા નામ",
