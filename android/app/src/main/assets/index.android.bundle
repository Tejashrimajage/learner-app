        children: "\u0935\u092F\u0938\u094D\u0915- \u0921\u0947\u091F\u093E/\u092B\u094B\u091F\u094B/\u0935\u0940\u0921\u093F\u092F\u094B/\u0907\u0902\u091F\u0930\u0935\u094D\u092F\u0942 \u0938\u0902\u0917\u094D\u0930\u0939 \u0938\u0939\u092E\u0924\u093F \u092A\u0924\u094D\u0930"
