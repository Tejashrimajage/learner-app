        children: "1. \u092A\u094D\u0930\u094B\u0917\u094D\u0930\u093E\u092E \u0915\u094B \u091A\u0932\u093E\u0928\u0947/\u0938\u0902\u091A\u093E\u0932\u093F\u0924 \u0915\u0930\u0928\u0947, \u0938\u092E\u0941\u0926\u093E\u092F \u0915\u0947 \u0932\u094B\u0917\u094B\u0902 \u0915\u094B \u091C\u094B\u0921\u093C\u0928\u0947 \u0914\u0930 \u0930\u093F\u092A\u094B\u0930\u094D\u091F\u093F\u0902\u0917 \u0939\u0947\u0924\u0941\u0964"
      }), /*#__PURE__*/(0, _jsxRuntime.jsx)(_GlobalText.default, {
        style: [_Style.default.text, {
          marginTop: 10
        }],
        children: "2. \u092A\u094D\u0930\u0925\u092E \u0915\u0947 \u092A\u094D\u0930\u0915\u093E\u0936\u0928\u094B\u0902 \u092E\u0947\u0902, \u0930\u093E\u0937\u094D\u091F\u094D\u0930\u0940\u092F \u0914\u0930 \u0905\u0902\u0924\u0930\u094D\u0930\u093E\u0937\u094D\u091F\u094D\u0930\u0940\u092F \u0921\u094B\u0928\u0930\u094B\u0902 \u0915\u094B \u0930\u093F\u092A\u094B\u0930\u094D\u091F \u0915\u0930\u0928\u0947 \u092E\u0947\u0902, \u092E\u0940\u0921\u093F\u092F\u093E, \u0938\u094B\u0936\u0932 \u092E\u0940\u0921\u093F\u092F\u093E (\u092B\u0947\u0938\u092C\u0941\u0915, \u091F\u094D\u0935\u093F\u091F\u0930, \u0907\u0902\u0938\u094D\u091F\u093E\u0917\u094D\u0930\u093E\u092E, \u0932\u093F\u0902\u0915\u094D\u0921\u0907\u0928, \u090F\u0915\u094D\u0938, \u0925\u094D\u0930\u0947\u0921\u094D\u0938, \u0906\u0926\u093F) \u0914\u0930 \u0921\u093F\u091C\u093F\u091F\u0932 \u092A\u094D\u0932\u0947\u091F\u092B\u0949\u0930\u094D\u092E\u094D\u0938 (\u092A\u094D\u0930\u0925\u092E \u0915\u0940 \u0935\u0947\u092C\u0938\u093E\u0907\u091F) \u090F\u0935\u0902 \u0938\u0940\u0916\u0928\u0947- \u0938\u093F\u0916\u093E\u0928\u0947 \u0915\u0947 \u092C\u093E\u0930\u0947 \u092E\u0947\u0902 \u091C\u093E\u0917\u0930\u0942\u0915\u0924\u093E \u092B\u0948\u0932\u093E\u0928\u0947 \u0939\u0947\u0924\u0941\u0964"
      }), /*#__PURE__*/(0, _jsxRuntime.jsx)(_GlobalText.default, {
        style: [_Style.default.text, {
          marginTop: 10
        }],
        children: "3. \u092A\u094D\u0930\u0925\u092E \u0915\u0947 \u0915\u093E\u0930\u094D\u092F \u0915\u0947 \u092C\u093E\u0930\u0947 \u092E\u0947\u0902 \u091C\u093E\u0917\u0930\u0942\u0915\u0924\u093E (\u0930\u093E\u0937\u094D\u091F\u094D\u0930\u0940\u092F, \u0905\u0902\u0924\u0930\u094D\u0930\u093E\u0937\u094D\u091F\u094D\u0930\u0940\u092F \u0921\u094B\u0928\u0930\u094D\u0938 \u0914\u0930 \u0905\u0928\u094D\u092F \u092A\u093E\u0930\u094D\u091F\u0928\u0930\u094D\u0938 \u0915\u0947 \u0938\u093E\u0925) \u0932\u093E\u0928\u0947 \u0939\u0947\u0924\u0941\u0964"
      }), /*#__PURE__*/(0, _jsxRuntime.jsx)(_GlobalText.default, {
        style: [_Style.default.text, {
          marginTop: 10
        }],
        children: "\u0906\u092A\u0938\u0947 \u0905\u0928\u0941\u0930\u094B\u0927 \u0939\u0948 \u0915\u093F \u0906\u092A \u0905\u092A\u0928\u0947 \u0938\u0947 \u0938\u0902\u092C\u0902\u0927\u093F\u0924 \u0909\u092A\u0930\u094D\u092F\u0941\u0915\u094D\u0924 \u091C\u093E\u0928\u0915\u093E\u0930\u093F\u092F\u094B\u0902 \u0915\u094B \u090F\u0915\u0924\u094D\u0930 \u0915\u0930\u0928\u0947, \u091C\u092E\u093E \u0915\u0930\u0928\u0947 \u0914\u0930 \u0938\u0940\u0916\u0928\u0947-\u0938\u093F\u0916\u093E\u0928\u0947 \u0915\u0940 \u0938\u093E\u092E\u0917\u094D\u0930\u0940 \u0915\u0947 \u0930\u0942\u092A \u092E\u0947\u0902 \u0907\u0938\u094D\u0924\u0947\u092E\u093E\u0932 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0938\u0939\u092E\u0924\u093F \u0926\u0947\u0902\u0964 \u0939\u093E\u0932\u093E\u0902\u0915\u093F, \u0907\u091A\u094D\u091B\u093E \u0905\u0928\u0941\u0938\u093E\u0930, \u0906\u092A \u0905\u092A\u0928\u0940 \u091C\u093E\u0928\u0915\u093E\u0930\u093F\u092F\u093E\u0901 \u0938\u093E\u091D\u093E \u0915\u0930\u0928\u0947 \u0938\u0947 \u092E\u0928\u093E \u092D\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
      }), /*#__PURE__*/(0, _jsxRuntime.jsx)(_GlobalText.default, {
        style: [_Style.default.text, {
          marginTop: 10
        }],
        children: "\u092E\u0948\u0902, \u092A\u094D\u0930\u0925\u092E \u0914\u0930 \u0909\u0938\u0915\u0947 \u0938\u094D\u0935\u092F\u0902\u0938\u0947\u0935\u0915\u094B\u0902 \u0914\u0930/\u092F\u093E \u092A\u094D\u0930\u0924\u093F\u0928\u093F\u0927\u093F\u092F\u094B\u0902 \u0915\u094B \u092C\u093F\u0928\u093E \u0915\u093F\u0938\u0940 \u0926\u092C\u093E\u0935 \u0915\u0947 \u092E\u0941\u091D\u0938\u0947 \u0938\u0902\u092C\u0902\u0927\u093F\u0924 \u0909\u092A\u0930\u094D\u092F\u0941\u0915\u094D\u0924 \u0938\u093E\u092E\u0917\u094D\u0930\u0940 \u0915\u093E \u0909\u092A\u092F\u094B\u0917, \u091C\u092E\u093E, \u0938\u093E\u091D\u093E \u0924\u0925\u093E \u092A\u094D\u0930\u0915\u093E\u0936\u093F\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093F\u090F \u0938\u0939\u092E\u0924\u093F \u0926\u0947\u0924\u0940/\u0926\u0947\u0924\u093E \u0939\u0942\u0901\u0964 \u092F\u0926\u093F \u092E\u0948\u0902 \u0915\u093F\u0938\u0940 \u092D\u0940 \u0938\u092E\u092F \u092F\u0939 \u0928\u093F\u0930\u094D\u0923\u092F \u0932\u0947\u0924\u0940/\u0932\u0947\u0924\u093E \u0939\u0942\u0901 \u0915\u093F \u0907\u0938 \u091C\u093E\u0928\u0915\u093E\u0930\u0940 \u0915\u094B \u092A\u094D\u0930\u0925\u092E \u0915\u0940 \u0938\u094D\u091F\u094B\u0930\u0947\u091C \u092A\u094D\u0932\u0947\u091F\u092B\u0949\u0930\u094D\u092E \u0938\u0947 \u0939\u091F\u093E\u092F\u093E, \u0905\u092A\u0921\u0947\u091F \u092F\u093E \u0938\u0902\u0936\u094B\u0927\u093F\u0924 \u0915\u093F\u092F\u093E \u091C\u093E\u0928\u093E \u091A\u093E\u0939\u093F\u090F, \u0924\u094B \u092E\u0948\u0902 \u092A\u094D\u0930\u0925\u092E \u0915\u0947 \u0938\u094D\u0935\u092F\u0902\u0938\u0947\u0935\u0915/\u092A\u094D\u0930\u0924\u093F\u0928\u093F\u0927\u093F \u0915\u094B \u092B\u094B\u0928/\u0908\u092E\u0947\u0932 \u0915\u0947 \u092E\u093E\u0927\u094D\u092F\u092E \u0938\u0947 \u0938\u0942\u091A\u093F\u0924 \u0915\u0930\u0942\u0902\u0917\u0940/\u0915\u0930\u0942\u0902\u0917\u093E, \u091C\u093F\u0938\u0915\u0947 \u092C\u093E\u0926 \u0932\u093F\u0916\u093F\u0924 \u0930\u0942\u092A \u092E\u0947\u0902 \u0938\u0939\u092E\u0924\u093F \u0915\u0940 \u0935\u093E\u092A\u0938\u0940/\u0905\u092A\u0921\u0947\u091F \u0915\u0947 \u0932\u093F\u090F \u0905\u0928\u0941\u0930\u094B\u0927 \u0915\u0930\u0942\u0902\u0917\u0940/\u0915\u0930\u0942\u0902\u0917\u093E\u0964 \u0907\u0938\u0915\u0947 \u092C\u093E\u0926, 15 \u0915\u093E\u0930\u094D\u092F \u0926\u093F\u0935\u0938\u094B\u0902 \u0915\u0947 \u0926\u094C\u0930\u093E\u0928 \u092A\u094D\u0930\u0925\u092E \u0907\u0938\u0947 \u0939\u091F\u093E \u0926\u0947\u0917\u093E \u092F\u093E \u0905\u092A\u0921\u0947\u091F \u0915\u0930\u0947\u0917\u093E\u0964"
      }), /*#__PURE__*/(0, _jsxRuntime.jsx)(_GlobalText.default, {
        style: [_Style.default.text, {
          marginTop: 10,
          marginBottom: 50
        }],
        children: "\u092E\u0948\u0902\u0928\u0947 \u0938\u092D\u0940 \u0924\u0925\u094D\u092F\u094B\u0902 \u0915\u094B \u0905\u091A\u094D\u091B\u0940 \u0924\u0930\u0939 \u0938\u0947 \u092A\u0922\u093C\u093E \u0914\u0930/\u092F\u093E \u092E\u0941\u091D\u0947 \u0938\u094D\u0925\u093E\u0928\u0940\u092F \u092D\u093E\u0937\u093E \u092E\u0947\u0902 \u0938\u092E\u091D\u093E\u092F\u093E \u0917\u092F\u093E \u0939\u0948 \u0914\u0930 \u092E\u0948\u0902 \u0938\u092D\u0940 \u0928\u093F\u092F\u092E\u094B\u0902 \u0914\u0930 \u091C\u093E\u0928\u0915\u093E\u0930\u093F\u092F\u094B\u0902 \u0915\u0947 \u0907\u0938\u094D\u0924\u0947\u092E\u093E\u0932 \u0915\u0947 \u0909\u0926\u094D\u0926\u0947\u0936\u094D\u092F\u094B\u0902 \u0915\u094B \u092A\u0942\u0930\u0940 \u0924\u0930\u0939 \u0938\u0947 \u0938\u092E\u091D\u0924\u0940/\u0938\u092E\u091D\u0924\u093E \u0939\u0942\u0901\u0964 \u092E\u0948\u0902\u0928\u0947 \u0907\u0938\u0938\u0947 \u0938\u0902\u092C\u0902\u0927\u093F\u0924 \u0905\u092A\u0928\u0940 \u091C\u093E\u0928\u0915\u093E\u0930\u093F\u092F\u094B\u0902 \u0915\u0947 \u0907\u0938\u094D\u0924\u0947\u092E\u093E\u0932 \u0915\u0947 \u092C\u093E\u0930\u0947 \u092E\u0947\u0902 \u092C\u0924\u093E\u0908 \u0917\u0908 \u0936\u0930\u094D\u0924\u094B\u0902 \u0915\u0940 \u0938\u094D\u0935\u0940\u0915\u0943\u0924\u093F \u0915\u0940 \u092A\u0941\u0937\u094D\u091F\u093F \u0915\u0930\u0924\u0940/\u0915\u0930\u0924\u093E \u0939\u0942\u0901 \u0914\u0930 \u090F\u0915\u0924\u094D\u0930 \u091C\u093E\u0928\u0915\u093E\u0930\u093F\u092F\u094B\u0902 \u0915\u0947 \u0907\u0938\u094D\u0924\u0947\u092E\u093E\u0932 \u0915\u0947 \u0938\u0902\u0926\u0930\u094D\u092D \u092E\u0947\u0902 \u0915\u093F\u0938\u0940 \u092D\u0940 \u0924\u0930\u0939 \u0915\u093E \u0915\u094B\u0908 \u092D\u0940 \u0926\u093E\u0935\u093E \u0928\u0939\u0940\u0902 \u0915\u0930\u0942\u0902\u0917\u0940/\u0915\u0930\u0942\u0902\u0917\u093E\u0964\""
      })]
    });
  };
  var _default = exports.default = ConsentAbove18;
