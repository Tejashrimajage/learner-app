          var HIDE_SELECTORS = [
            '.launch-app-btn',
            '#btn-join-app',
            '.app-banner',
            '.open-app-banner',
            '.zm-btn-legacy.open-in-desktop',
            '[class*="open-in-app"]',
            '[class*="openInApp"]',
            '[class*="launch-app"]',
            '[id*="open-in-app"]',
