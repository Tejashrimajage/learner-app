        children: "2. \u092A\u094D\u0930\u0925\u092E \u0915\u0947 \u092A\u094D\u0930\u0915\u093E\u0936\u0928\u094B\u0902 \u092E\u0947\u0902, \u0930\u093E\u0937\u094D\u091F\u094D\u0930\u0940\u092F \u0914\u0930 \u0905\u0902\u0924\u0930\u094D\u0930\u093E\u0937\u094D\u091F\u094D\u0930\u0940\u092F \u0921\u094B\u0928\u0930\u094B\u0902 \u0915\u094B \u0930\u093F\u092A\u094B\u0930\u094D\u091F \u0915\u0930\u0928\u0947 \u092E\u0947\u0902, \u092E\u0940\u0921\u093F\u092F\u093E, \u0938\u094B\u0936\u0932 \u092E\u0940\u0921\u093F\u092F\u093E (\u092B\u0947\u0938\u092C\u0941\u0915, \u091F\u094D\u0935\u093F\u091F\u0930, \u0907\u0902\u0938\u094D\u091F\u093E\u0917\u094D\u0930\u093E\u092E, \u0932\u093F\u0902\u0915\u094D\u0921\u0907\u0928, \u0925\u094D\u0930\u0947\u0921\u094D\u0938, \u0906\u0926\u093F) \u0914\u0930 \u0921\u093F\u091C\u093F\u091F\u0932 \u092A\u094D\u0932\u0947\u091F\u092B\u0949\u0930\u094D\u092E\u094D\u0938 (\u092A\u094D\u0930\u0925\u092E \u0915\u0940 \u0935\u0947\u092C\u0938\u093E\u0907\u091F) \u090F\u0935\u0902 \u0938\u0940\u0916\u0928\u0947- \u0938\u093F\u0916\u093E\u0928\u0947 \u0915\u0947 \u092C\u093E\u0930\u0947 \u092E\u0947\u0902 \u091C\u093E\u0917\u0930\u0942\u0915\u0924\u093E \u092B\u0948\u0932\u093E\u0928\u0947 \u0939\u0947\u0924\u0941\u0964"
